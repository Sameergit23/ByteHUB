# ==============================================================================
# ByteHUB Production Environment Template (.env.production.example)
#
# Copy the values into your host's secret manager. Never commit real values.
# The API refuses to start in production if payment keys, email delivery, HTTPS,
# resume storage or demo accounts are not production-ready (see the start-up log).
# ==============================================================================

# ------------------------------------------------------------------------------
# API service (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0

# Public https address of the website. Used for CORS/CSRF checks and links in emails.
FRONTEND_URL=https://bytehub.example.com

# Public https address of the API (no trailing /api). Cashfree delivers payment webhooks to
# <API_PUBLIC_URL>/api/payments/webhooks/cashfree — also set that URL in the Cashfree dashboard.
API_PUBLIC_URL=https://api.bytehub.example.com

# Managed PostgreSQL with SSL. Run `pnpm db:deploy` (prisma migrate deploy) before each release.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require&schema=public"

# Session signing key: at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"

# Cashfree Payments (live). Whitelist your website domain in the Cashfree dashboard first.
CASHFREE_APP_ID="REPLACE_WITH_LIVE_APP_ID"
CASHFREE_SECRET_KEY="REPLACE_WITH_LIVE_SECRET_KEY"
CASHFREE_ENV="PRODUCTION"
CASHFREE_API_VERSION="2023-08-01"

# Razorpay and Stripe are NOT active: checkout only offers Cashfree, and their webhooks are
# rejected unless real keys are set here. Leave these unset.
# RAZORPAY_KEY_ID= / RAZORPAY_KEY_SECRET= / RAZORPAY_WEBHOOK_SECRET=
# STRIPE_SECRET_KEY= / STRIPE_PUBLISHABLE_KEY= / STRIPE_WEBHOOK_SECRET=

# Transactional email. Only Resend is implemented (SES/SENDGRID are not).
# The sender domain needs SPF, DKIM and DMARC records — see README section 6.
EMAIL_PROVIDER=RESEND
EMAIL_FROM="ByteHUB Admissions <admissions@bytehub.example.com>"
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# Uploaded resumes. Free hosting (e.g. Render's free plan) has no permanent disk, so store
# them in a PRIVATE Supabase Storage bucket. The API creates the bucket on first start.
#   SUPABASE_URL: Supabase → Project Settings → Data API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API Keys → "service_role" (legacy)
#     or a Secret key (sb_secret_...). Server-only: never put it on the website service.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_OR_SECRET_KEY"
SUPABASE_STORAGE_BUCKET=resumes
# Alternative on a paid plan with a persistent disk mounted at this path:
# STORAGE_DRIVER=local
# RESUME_STORAGE_DIR=/app/data/resumes

# Reverse-proxy hops in front of the API: 1 for the Next.js /api proxy, +1 for each load
# balancer in front of it. Wrong values break per-client rate limits and audit-log IPs.
TRUST_PROXY=2

# Recurring jobs (seat-hold expiry, payment reconciliation, session cleanup). Background jobs
# and rate limits are kept in memory: run ONE API instance, or set "off" on all but one.
BACKGROUND_JOBS=on
RATE_LIMIT_GLOBAL_MAX=1000

# Error reporting (optional but strongly recommended): your Sentry project's DSN.
SENTRY_DSN=
# Slack-compatible incoming webhook for critical alerts (dead-lettered jobs, payments that
# need manual review, forged webhooks). Optional.
ALERT_WEBHOOK_URL=

# GST: set only once you are GST-registered; receipts then show it.
GSTIN=

# Must stay "false" in production. (Staging may use "true" to keep seeded demo accounts.)
ALLOW_DEMO_ACCOUNTS=false

# ------------------------------------------------------------------------------
# Web service (apps/web)
# ------------------------------------------------------------------------------
# Address the web server uses to reach the API, including /api. The browser never calls it
# directly — Next.js proxies /api/* to it. Must also be passed at IMAGE BUILD time:
#   docker build --build-arg API_INTERNAL_URL=... -f apps/web/Dockerfile .
API_INTERNAL_URL=http://api:5000/api

# Public website address used in the sitemap, social previews and legal pages.
NEXT_PUBLIC_SITE_URL=https://bytehub.example.com
