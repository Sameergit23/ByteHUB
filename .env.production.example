# ==============================================================================
# ByteHUB Production Environment Template (.env.production.example)
# Production managed PostgreSQL with connection pooler, live keys, strict SSL
# ==============================================================================

# Application & Runtime
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://bytehub.dev
NEXT_PUBLIC_API_URL=https://api.bytehub.dev/api
APP_VERSION=1.0.0
CDN_URL=https://cdn.bytehub.dev

# Primary Managed PostgreSQL (AWS RDS / Supabase / Neon with SSL & PgBouncer pooling)
DATABASE_URL="postgresql://bytehub_prod_user:PROD_SUPER_SECURE_PASSWORD@prod-pg-pooler.internal.bytehub.net:5432/bytehub_prod?sslmode=require&connection_limit=50&pool_timeout=10&schema=public"

# Redis Cluster (AWS ElastiCache / Redis Enterprise with TLS & Auth)
REDIS_URL="rediss://:PROD_STRONG_REDIS_PASSWORD@prod-redis-cluster.internal.bytehub.net:6379"

# Authentication & Session Security (Cryptographically generated 64-char key)
# Generate via: openssl rand -base64 48
JWT_SECRET="PRODUCTION_JWT_SECRET_MUST_BE_MIN_64_CHARACTERS_HEX_OR_BASE64_KEY"
JWT_EXPIRES_IN="7d"

# Payment Gateways (LIVE PRODUCTION KEYS - STORED IN SECRETS MANAGER)
# Razorpay Live Credentials
RAZORPAY_KEY_ID="rzp_live_PROD_LIVE_KEY_ID"
RAZORPAY_KEY_SECRET="PROD_LIVE_RAZORPAY_SECRET_KEY"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_PROD_LIVE_WEBHOOK_SIGNING_SECRET"

# Stripe Live Credentials
STRIPE_PUBLISHABLE_KEY="pk_live_PROD_LIVE_STRIPE_PUBLISHABLE_KEY"
STRIPE_SECRET_KEY="sk_live_PROD_LIVE_STRIPE_SECRET_KEY"
STRIPE_WEBHOOK_SECRET="whsec_PROD_LIVE_STRIPE_WEBHOOK_SECRET"

# Private Storage Bucket (AWS S3 / Cloudflare R2 - SSE-KMS, Block All Public Access, Presigned URLs)
STORAGE_DRIVER=s3
S3_BUCKET_NAME=bytehub-prod-resumes-private
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_PROD_IAM_USER_LEAST_PRIVILEGE
AWS_SECRET_ACCESS_KEY=PROD_IAM_USER_SECRET_ACCESS_KEY

# Email Delivery (Resend / AWS SES Production Tier with SPF, DKIM, DMARC)
EMAIL_PROVIDER=RESEND
EMAIL_FROM="ByteHUB Admissions <admissions@bytehub.dev>"
RESEND_API_KEY=re_prod_live_resend_api_key

# Monitoring & Real-Time Incident Alerting
SENTRY_DSN="https://prod_sentry_key@o0.ingest.sentry.io/0000002"
ALERT_WEBHOOK_URL="https://events.pagerduty.com/v2/enqueue"
SLACK_ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/ProdIncidentWarRoom"
