# ==============================================================================
# ByteHUB Staging Environment Template (.env.staging.example)
# Dedicated staging database, isolated secrets, test payment gateways
# ==============================================================================

# Application & Runtime
NODE_ENV=production
PORT=5000
FRONTEND_URL=https://staging.bytehub.internal
NEXT_PUBLIC_API_URL=https://staging-api.bytehub.internal/api
APP_VERSION=1.0.0-staging

# Primary Managed PostgreSQL (Staging instance, SSL required)
DATABASE_URL="postgresql://staging_user:STAGING_STRONG_PASSWORD_HERE@staging-pg.internal.bytehub:5432/bytehub_staging?sslmode=require&schema=public"

# Redis Cache & BullMQ Queue (Managed Staging Redis)
REDIS_URL="rediss://:STAGING_REDIS_PASSWORD@staging-redis.internal.bytehub:6380"

# Authentication & Session Security (Distinct staging secret)
JWT_SECRET="STAGING_JWT_SECRET_CRYPTO_RANDOM_MIN_64_CHARACTERS_HEX_OR_BASE64_KEY"
JWT_EXPIRES_IN="7d"

# Payment Gateways (STAGING TEST MODE KEYS ONLY)
RAZORPAY_KEY_ID="rzp_test_staging_key_id"
RAZORPAY_KEY_SECRET="rzp_test_staging_key_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_staging_secret"

STRIPE_PUBLISHABLE_KEY="pk_test_staging_stripe_publishable_key"
STRIPE_SECRET_KEY="sk_test_staging_stripe_secret_key"
STRIPE_WEBHOOK_SECRET="whsec_staging_stripe_signing_secret"

# Private Storage (AWS S3 Staging Bucket with SSE-KMS & Block Public Access)
STORAGE_DRIVER=s3
S3_BUCKET_NAME=bytehub-staging-resumes-private
S3_REGION=ap-south-1
AWS_ACCESS_KEY_ID=AKIA_STAGING_PLACEHOLDER
AWS_SECRET_ACCESS_KEY=STAGING_AWS_SECRET_KEY_PLACEHOLDER

# Email Delivery (Resend / SES in sandbox mode)
EMAIL_PROVIDER=RESEND
EMAIL_FROM="ByteHUB Staging <admissions-staging@bytehub.internal>"
RESEND_API_KEY=re_staging_api_key_placeholder

# Monitoring & Alerting (Staging Sentry Project & Slack/PagerDuty Webhook)
SENTRY_DSN="https://staging_sentry_key@o0.ingest.sentry.io/0000001"
ALERT_WEBHOOK_URL="https://hooks.slack.com/services/T00/B00/StagingAlertWebhook"
