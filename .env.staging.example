# ==============================================================================
# ByteHUB Staging Environment Template (.env.staging.example)
#
# Same shape as .env.production.example, but with its own database and Cashfree SANDBOX
# keys so full payments can be tested without real money. Never point staging at the
# production database.
# ==============================================================================

# ------------------------------------------------------------------------------
# API service (apps/api)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=5000
APP_VERSION=1.0.0-staging

FRONTEND_URL=https://staging.bytehub.example.com
API_PUBLIC_URL=https://staging-api.bytehub.example.com

DATABASE_URL="postgresql://USER:PASSWORD@STAGING_HOST:5432/bytehub_staging?sslmode=require&schema=public"
JWT_SECRET="REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_SECRET"

# Cashfree SANDBOX credentials (from the Cashfree test dashboard).
CASHFREE_APP_ID="REPLACE_WITH_SANDBOX_APP_ID"
CASHFREE_SECRET_KEY="REPLACE_WITH_SANDBOX_SECRET_KEY"
CASHFREE_ENV="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"

EMAIL_PROVIDER=RESEND
EMAIL_FROM="ByteHUB Staging <staging@bytehub.example.com>"
RESEND_API_KEY="REPLACE_WITH_RESEND_API_KEY"

# Uploaded resumes. Free hosting (e.g. Render's free plan) has no permanent disk, so store
# them in a PRIVATE Supabase Storage bucket. The API creates the bucket on first start.
#   SUPABASE_URL: Supabase → Project Settings → Data API → Project URL
#   SUPABASE_SERVICE_ROLE_KEY: Supabase → Project Settings → API Keys → "service_role" (legacy)
#     or a Secret key (sb_secret_...). Server-only: never put it on the website service.
STORAGE_DRIVER=supabase
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_SERVICE_ROLE_OR_SECRET_KEY"
SUPABASE_STORAGE_BUCKET=resumes
# Alternative on a paid plan with a persistent disk mounted at this path:
# STORAGE_DRIVER=local
# RESUME_STORAGE_DIR=/app/data/resumes
TRUST_PROXY=2
BACKGROUND_JOBS=on
RATE_LIMIT_GLOBAL_MAX=1000

SENTRY_DSN=
ALERT_WEBHOOK_URL=

# Staging may keep the seeded demo accounts (password published in prisma/seed.ts) so testers
# can sign in. Production must never set this.
ALLOW_DEMO_ACCOUNTS=true

# ------------------------------------------------------------------------------
# Web service (apps/web)
# ------------------------------------------------------------------------------
API_INTERNAL_URL=http://api:5000/api
NEXT_PUBLIC_SITE_URL=https://staging.bytehub.example.com
