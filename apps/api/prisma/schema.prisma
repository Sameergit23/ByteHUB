generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  STUDENT
  COMPANY
  ADMIN
}

enum InternshipType {
  REMOTE
  HYBRID
  ON_SITE
}

enum InternshipStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  SUBMITTED
  UNDER_REVIEW
  INTERVIEW
  OFFERED
  REJECTED
  WITHDRAWN
}

enum PaymentProvider {
  CASHFREE
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum EnrollmentStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  EXPIRED
}

// ---------------------------------------------------------------------------
// 1. Identity, Auth & Profiles
// ---------------------------------------------------------------------------

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String
  name                    String
  role                    Role                     @default(STUDENT)
  isEmailVerified         Boolean                  @default(false)
  organizationName        String?
  deletedAt               DateTime?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  studentProfile          StudentProfile?
  companyProfile          CompanyProfile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  internships             Internship[]             @relation("CompanyInternships")
  applications            Application[]            @relation("StudentApplications")
  enrollments             Enrollment[]
  payments                Payment[]
  certificates            Certificate[]
  auditLogs               AuditLog[]

  @@index([role])
  @@index([deletedAt])
  @@index([createdAt])
}

model RefreshToken {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  deviceInfo String?
  expiresAt  DateTime
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId])
  @@index([tokenHash])
}

model StudentProfile {
  id             String    @id @default(uuid())
  userId         String    @unique
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  phone          String?
  college        String
  graduationYear Int
  degree         String
  bioSummary     String?
  resumeUrl      String?
  githubUrl      String?
  linkedinUrl    String?
  portfolioUrl   String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([userId])
  @@index([graduationYear])
}

model CompanyProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyName String
  website     String?
  industry    String?
  description String?
  logoUrl     String?
  verified    Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([verified])
}

// ---------------------------------------------------------------------------
// 2. Tracks, Programmes & Cohorts
// ---------------------------------------------------------------------------

model Track {
  id           String       @id @default(uuid())
  slug         String       @unique
  name         String
  description  String
  displayOrder Int          @default(0)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  programmes   Programme[]
  internships  Internship[]

  @@index([slug])
  @@index([displayOrder])
}

model Programme {
  id            String    @id @default(uuid())
  trackId       String
  track         Track     @relation(fields: [trackId], references: [id], onDelete: Restrict)
  slug          String    @unique
  title         String
  summary       String
  description   String
  syllabus      Json
  prerequisites String[]
  published     Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  cohorts       Cohort[]

  @@index([trackId])
  @@index([slug])
  @@index([published])
}

model Cohort {
  id            String       @id @default(uuid())
  programmeId   String
  programme     Programme    @relation(fields: [programmeId], references: [id], onDelete: Restrict)
  cohortCode    String       @unique
  name          String
  mode          String       // REMOTE, ON_SITE, HYBRID
  startDate     DateTime
  endDate       DateTime
  durationWeeks Int
  seatsTotal    Int
  seatsLeft     Int
  priceAmount   Int          // Smallest unit (e.g. 2400000 paise = 24,000 INR). Never floats.
  currency      String       @default("INR")
  published     Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  enrollments   Enrollment[]
  payments      Payment[]

  @@index([programmeId])
  @@index([startDate])
  @@index([published])
}

// ---------------------------------------------------------------------------
// 3. Internships & Applications
// ---------------------------------------------------------------------------

model Internship {
  id             String           @id @default(uuid())
  companyId      String
  company        User             @relation("CompanyInternships", fields: [companyId], references: [id], onDelete: Cascade)
  trackId        String?
  track          Track?           @relation(fields: [trackId], references: [id], onDelete: SetNull)
  slug           String           @unique
  title          String
  companyName    String
  location       String
  type           InternshipType   @default(REMOTE)
  stipendAmount  Int              @default(0) // Smallest unit (e.g. 3500000 paise = 35,000 INR). Never floats.
  currency       String           @default("INR")
  durationMonths Int              @default(3)
  description    String
  whatYouWillDo  String[]
  requirements   String[]
  skills         String[]
  openings       Int              @default(1)
  deadline       DateTime
  status         InternshipStatus @default(PUBLISHED)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  applications   Application[]

  @@index([companyId])
  @@index([trackId])
  @@index([status])
  @@index([type])
  @@index([deadline])
  @@index([createdAt])
}

model Application {
  id                         String            @id @default(uuid())
  internshipId               String
  internship                 Internship        @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  studentId                  String
  student                    User              @relation("StudentApplications", fields: [studentId], references: [id], onDelete: Cascade)
  fullName                   String
  email                      String
  phone                      String
  collegeOrUniversity        String
  graduationYear             Int
  degree                     String
  githubUrl                  String
  linkedinUrl                String
  portfolioUrl               String?
  resumeUrl                  String
  bioSummary                 String
  whyInterested              String
  relevantProjectDescription String
  availableHoursPerWeek      Int
  earliestStartDate          DateTime
  status                     ApplicationStatus @default(SUBMITTED)
  feedbackNote               String?
  deletedAt                  DateTime?
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt

  // Unique constraint: one active application per student per internship
  @@unique([studentId, internshipId])
  @@index([internshipId])
  @@index([studentId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 4. Enrollments, Payments, Webhook Events & Refunds (ACID Financial Core)
// ---------------------------------------------------------------------------

model Enrollment {
  id            String           @id @default(uuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohortId      String
  cohort        Cohort           @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  paymentId     String?
  payment       Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  status        EnrollmentStatus @default(PENDING)
  reservedUntil DateTime?
  priceAmount   Int              @default(0) // Captured price at reservation in smallest unit
  currency      String           @default("INR")
  deletedAt     DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  certificate   Certificate?

  // Unique constraint: one enrollment per student per cohort
  @@unique([userId, cohortId])
  @@index([userId])
  @@index([cohortId])
  @@index([status])
  @@index([reservedUntil])
}

model Payment {
  id                   String          @id @default(uuid())
  orderId              String          @unique
  userId               String
  user                 User            @relation(fields: [userId], references: [id], onDelete: Restrict)
  cohortId             String
  cohort               Cohort          @relation(fields: [cohortId], references: [id], onDelete: Restrict)
  provider             PaymentProvider
  amount               Int             // Smallest unit (e.g. paise or cents). Never floats.
  currency             String          @default("INR")
  status               PaymentStatus   @default(CREATED)
  gatewayPaymentId     String?
  gatewaySignature     String?
  idempotencyKey       String          @unique
  metadata             Json?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt

  enrollments          Enrollment[]
  refunds              Refund[]
  paymentEvents        PaymentEvent[]

  @@index([userId])
  @@index([cohortId])
  @@index([status])
  @@index([orderId])
  @@index([idempotencyKey])
  @@index([createdAt])
}

model PaymentEvent {
  id              String          @id @default(uuid())
  paymentId       String?
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  provider        PaymentProvider
  eventType       String
  eventId         String?         @unique
  rawPayload      Json
  signatureHeader String?
  processed       Boolean         @default(false)
  processingError String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([paymentId])
  @@index([provider])
  @@index([eventType])
  @@index([processed])
  @@index([createdAt])
}

model Refund {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  amount          Int      // Smallest unit (paise/cents). Never floats.
  currency        String   @default("INR")
  reason          String
  gatewayRefundId String?  @unique
  status          String   @default("PENDING") // PENDING, PROCESSED, FAILED
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([paymentId])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// 5. Certificates, Contact Messages & Audit Trail
// ---------------------------------------------------------------------------

model Certificate {
  id              String     @id @default(uuid())
  enrollmentId    String     @unique
  enrollment      Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Restrict)
  userId          String
  user            User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  certificateCode String     @unique
  title           String
  issuedAt        DateTime   @default(now())
  revokedAt       DateTime?
  verificationUrl String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([userId])
  @@index([enrollmentId])
  @@index([certificateCode])
}

model ContactMessage {
  id          String    @id @default(uuid())
  fullName    String
  email       String
  topic       String
  message     String
  isRead      Boolean   @default(false)
  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([email])
  @@index([topic])
  @@index([isRead])
  @@index([createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String
  entityId   String
  details    Json?
  ipAddress  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}
