# ByteHUB API Environment Configuration Template
# Copy this file to .env and provide your environment-specific credentials.
# Do NOT commit real secrets or production keys to version control.

PORT=5000
NODE_ENV=development

# PostgreSQL Connection String (Primary Database for ACID Transactions)
DATABASE_URL="postgresql://placeholder_user:placeholder_password@localhost:5432/bytehub_dev?schema=public"

# Authentication
# Must be at least 32 characters in length
JWT_SECRET="placeholder_secret_minimum_32_characters_long_for_security"
JWT_EXPIRES_IN="7d"

# Razorpay Payment Gateway (Domestic India: UPI, RuPay, Netbanking)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_webhook_secret_placeholder"

# Stripe Payment Gateway (International Cards: 3D Secure 2)
STRIPE_SECRET_KEY="sk_test_placeholder_secret_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_publishable_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_webhook_signing_secret"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"

# Transactional Email Provider (RESEND, SES, SENDGRID, or MOCK for tests)
EMAIL_PROVIDER="MOCK"
EMAIL_FROM="ByteHUB Admissions <admissions@bytehub.dev>"
RESEND_API_KEY="re_placeholder_test_key"

# BullMQ Redis URL (Optional: in-memory queue fallback if absent)
REDIS_URL="redis://localhost:6379"

# Cashfree Payments (the only gateway wired end to end: UPI, cards, netbanking)
# Leave the test_ placeholders for local development: checkout then runs in a clearly
# labelled test mode. Production refuses to start without real credentials.
CASHFREE_APP_ID="test_cashfree_app_id"
CASHFREE_SECRET_KEY="test_cashfree_secret_key"
CASHFREE_ENV="SANDBOX"
CASHFREE_API_VERSION="2023-08-01"

# Public base URL of this API. When set, Cashfree delivers payment webhooks to
# <API_PUBLIC_URL>/api/payments/webhooks/cashfree
# API_PUBLIC_URL="https://api.example.com"

# Reverse-proxy hops in front of the API (the Next.js "/api" proxy counts as one; add one
# more for a load balancer). Keeps rate limits and audit logs keyed on the real client IP.
TRUST_PROXY=1

# Recurring jobs: seat-hold expiry (every minute), payment reconciliation (every 30 minutes),
# session cleanup (daily). Set to "off" on all but one instance when running several replicas.
BACKGROUND_JOBS="on"

# Flood ceiling: requests per client IP per 15 minutes across the whole API.
RATE_LIMIT_GLOBAL_MAX=1000

# Uploaded resumes: "local" disk (default) or a private Supabase Storage bucket.
# STORAGE_DRIVER=local
# RESUME_STORAGE_DIR=/app/data/resumes
# STORAGE_DRIVER=supabase
# SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=resumes

# Staging only: allow a production-mode server to start while seeded demo accounts exist.
ALLOW_DEMO_ACCOUNTS=false

# Error reporting (optional): Sentry DSN, and a Slack-compatible webhook for critical alerts.
# SENTRY_DSN=
# ALERT_WEBHOOK_URL=
