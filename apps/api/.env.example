# ByteHUB API Environment Config
PORT=5000
NODE_ENV=development
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/bytehub?schema=public"
JWT_SECRET="replace_with_a_secure_random_64_character_hex_string_in_production"
JWT_EXPIRES_IN="7d"

# Razorpay (India: UPI, Netbanking, Cards)
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="rzp_test_placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="rzp_test_webhook_secret"

# Stripe (International Cards)
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_secret"

# Frontend Origin for CORS
FRONTEND_URL="http://localhost:3000"
