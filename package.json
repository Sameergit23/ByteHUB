{
  "name": "bytehub",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @bytehub/web --filter @bytehub/api dev",
    "dev:web": "pnpm --filter @bytehub/web dev",
    "dev:api": "pnpm --filter @bytehub/api dev",
    "build": "pnpm --filter @bytehub/shared build && pnpm --filter @bytehub/api build && pnpm --filter @bytehub/web build",
    "test": "node --test apps/api/tests/*.test.mjs apps/api/tests/integration/*.test.mjs apps/api/tests/security/*.test.mjs packages/shared/tests/*.mjs scripts/*.mjs",
    "test:all": "node --test apps/api/tests/*.test.mjs apps/api/tests/integration/*.test.mjs apps/api/tests/security/*.test.mjs packages/shared/tests/*.mjs scripts/*.mjs",
    "test:drills": "node --test scripts/*.mjs",
    "test:e2e": "playwright test",
    "db:backup": "bash scripts/backup-db.sh",
    "db:restore": "bash scripts/restore-db.sh",
    "lint": "pnpm --recursive run lint",
    "lint:fix": "pnpm --recursive run lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,prisma}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,prisma}\"",
    "typecheck": "pnpm --recursive run typecheck",
    "prepare": "husky install"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.14.0",
    "@typescript-eslint/parser": "^8.14.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3"
  }
}
