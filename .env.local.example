# ==============================================================================
# ByteHUB Local Development Environment Template (.env.local.example)
# Use with docker-compose or local pnpm dev
# ==============================================================================

# Application & Runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
APP_VERSION=1.0.0

# Primary PostgreSQL (Local Docker or Localhost)
DATABASE_URL="postgresql://bytehub_user:bytehub_secure_local_dev_password@localhost:5432/bytehub_dev?schema=public"

# Redis Cache & BullMQ Queue
REDIS_URL="redis://:bytehub_redis_pass@localhost:6379"

# Authentication & Session Security (Min 32 characters)
JWT_SECRET="local_dev_secret_key_needs_to_be_at_least_32_chars_long_xyz"
JWT_EXPIRES_IN="7d"

# Payment Gateways (TEST MODE CREDENTIALS ONLY)
# Razorpay Test Dashboard: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID="rzp_test_5y1k0aB9Example"
RAZORPAY_KEY_SECRET="mock_rzp_test_secret_998877"
RAZORPAY_WEBHOOK_SECRET="rzp_whsec_local_test_key_abc123"

# Stripe Test Dashboard: https://dashboard.stripe.com/test/apikeys
STRIPE_PUBLISHABLE_KEY="pk_test_51MockByteHubKey0011223344"
STRIPE_SECRET_KEY="sk_test_51MockByteHubSecretKey5566778899"
STRIPE_WEBHOOK_SECRET="whsec_mock_stripe_webhook_signing_secret_test"

# S3 / MinIO Private Document Storage (Local Emulator)
STORAGE_DRIVER=minio
S3_ENDPOINT=http://localhost:9000
S3_BUCKET_NAME=bytehub-resumes
S3_REGION=us-east-1
S3_ACCESS_KEY=bytehub_minio_admin
S3_SECRET_KEY=bytehub_minio_secret_key

# Email Delivery (Mock for local testing)
EMAIL_PROVIDER=MOCK
EMAIL_FROM="ByteHUB Admissions <admissions@bytehub.dev>"
RESEND_API_KEY=re_local_mock_key

# Error Tracking (Optional in local dev)
SENTRY_DSN=""
ALERT_WEBHOOK_URL=""
